# Build output
/agentbox
/out/

# macOS
.DS_Store

# Local secrets — never commit
.env
.env.*
!.env.example

# Local compose customization (extra mounts, etc.)
docker-compose.override.yml

# Local scheduler config
schedule.yaml
config/schedule.yaml

# Local todo + note store and capture inbox (default locations under the workspace)
/todos/
/notes/
/captures/

# Local notes/todo store and capture inbox and daily journal
/journal/

# Agent's persistent, self-built tool library (runtime state)
/tools/

# Deploy-folder runtime artifacts (.env and schedule.yaml are already ignored above)
/deploy/todos/
/deploy/notes/
/deploy/captures/
/deploy/journal/
/deploy/tools/
/deploy/docker-compose.override.yml
