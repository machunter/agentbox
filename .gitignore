# Build output
/agentbox
/out/

# macOS
.DS_Store

# Local secrets — never commit
.env
.env.*
!.env.example

# Local compose customization (extra mounts, etc.)
docker-compose.override.yml

# Local scheduler config
schedule.yaml

# Local notes/todo store and capture inbox (default locations under the workspace)
/notes/
/captures/

# Deploy-folder runtime artifacts (.env and schedule.yaml are already ignored above)
/deploy/notes/
/deploy/captures/
/deploy/docker-compose.override.yml
