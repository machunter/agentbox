# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: read-only email access (IMAP). Set all three to enable the email
# tools. Use an app password, not your account password.
# AGENTBOX_IMAP_HOST=imap.gmail.com
# AGENTBOX_IMAP_PORT=993
# AGENTBOX_IMAP_USER=you@example.com
# AGENTBOX_IMAP_PASS=your-app-password

# Optional: read-only calendar via iCal (ICS) feed URLs, comma-separated.
# In Google Calendar: Settings > [calendar] > Integrate calendar >
# "Secret address in iCal format". AGENTBOX_TIMEZONE sets day boundaries.
# AGENTBOX_ICS_URLS=https://calendar.google.com/calendar/ical/.../basic.ics
# AGENTBOX_TIMEZONE=America/New_York
