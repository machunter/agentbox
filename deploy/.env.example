# Copy to .env (in this folder). .env is read by docker compose.
# Kept in sync with the repo's .env.example — the only intended difference is
# AGENTBOX_IMAGE (below), since this deployment runs the published image.

# --- Model + API key ---
# A claude-* name uses Claude (needs ANTHROPIC_API_KEY); a gemini-* name uses
# Gemini (needs GEMINI_API_KEY or GOOGLE_API_KEY). Defaults to claude-opus-4-8.
# AGENTBOX_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...

# --- Deploy ---
# Pin a specific published image (default: machunter/agentbox:latest):
# AGENTBOX_IMAGE=machunter/agentbox:0.2.0

# --- General ---
# Timezone for schedules, day boundaries, and event/journal times:
# AGENTBOX_TIMEZONE=America/New_York
# Isolate long-term memory per deployment (e.g. "personal" vs "work"):
# AGENTBOX_NAMESPACE=default

# --- Email (read-only IMAP) ---
# Set host/user/pass to enable the email tools. Use an app password (no spaces).
# AGENTBOX_IMAP_HOST=imap.gmail.com
# AGENTBOX_IMAP_PORT=993
# AGENTBOX_IMAP_USER=you@example.com
# AGENTBOX_IMAP_PASS=your-app-password
# Minimum lookback window (days); the agent can widen but not narrow it
# (0/unset = no date limit):
# AGENTBOX_EMAIL_SINCE_DAYS=14

# --- Calendar (read-only ICS) ---
# iCal feed URLs, comma-separated. Google Calendar: Settings > [calendar] >
# Integrate calendar > "Secret address in iCal format".
# AGENTBOX_ICS_URLS=https://calendar.google.com/calendar/ical/.../basic.ics
# Seconds to fetch a feed; raise for large feeds, tens of MB (default 60):
# AGENTBOX_CAL_TIMEOUT=120
# Seconds to reuse a cached feed before revalidating (default 900; 0 = always):
# AGENTBOX_CAL_CACHE_TTL=900

# --- Slack (read-only) ---
# A Slack token enables the Slack tools (list_channels, read_channel,
# read_thread, search_messages). Create a Slack app, add read scopes, install it
# to your workspace, and paste its token. Use a user token (xoxp-) — required for
# search_messages; a bot token (xoxb-) works for the rest.
# AGENTBOX_SLACK_TOKEN=xoxp-...
# Default history lookback (days); the agent can override per call (0 = none):
# AGENTBOX_SLACK_LOOKBACK_DAYS=7

# --- Behavior ---
# Max tool-call rounds per run before it stops and summarizes (default 50):
# AGENTBOX_MAX_TOOL_CALLS=80
# Verbose debug logging to stderr (model/tool I/O, memory, capture decisions):
# AGENTBOX_DEBUG=1

# --- Host folders mounted into the container (compose only) ---
# What the agent can read/act on, mounted at /workspace (default: current dir):
# AGENTBOX_WORKSPACE=/Users/you/notes
# Photo capture inbox — point at a phone-synced folder (default ./captures):
# AGENTBOX_CAPTURE_HOST=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/agentbox-inbox
# Daily-output journal folder (default ./journal):
# AGENTBOX_JOURNAL_HOST=./journal
# Persistent tool library the agent builds up and reuses (default ./tools):
# AGENTBOX_TOOLS_HOST=./tools
# Folder holding schedule.yaml, mounted read-only at /etc/agentbox (default ./config):
# AGENTBOX_CONFIG_DIR=./config
