# Copy to .env (in this folder) and fill in. .env is read by docker compose.

# Which model to use, and the matching API key.
#   claude-*  -> needs ANTHROPIC_API_KEY
#   gemini-*  -> needs GEMINI_API_KEY (or GOOGLE_API_KEY)
AGENTBOX_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Which host folder the agent can act on (mounted at /workspace). Default: this folder.
# AGENTBOX_WORKSPACE=/Users/you/notes

# Pin a specific image version (default: machunter/agentbox:latest).
# AGENTBOX_IMAGE=machunter/agentbox:0.1.0

# Memory isolation if you run more than one deployment.
# AGENTBOX_NAMESPACE=personal
# AGENTBOX_TIMEZONE=America/Los_Angeles

# --- Optional connectors ---
# Read-only email (use an app password with no spaces):
# AGENTBOX_IMAP_HOST=imap.gmail.com
# AGENTBOX_IMAP_USER=you@example.com
# AGENTBOX_IMAP_PASS=your16charapppassword
# AGENTBOX_EMAIL_SINCE_DAYS=7   # minimum lookback window in days; agent can widen, not narrow (0/unset = no limit)
# Read-only calendar (ICS "secret address" URL):
# AGENTBOX_ICS_URLS=https://calendar.google.com/calendar/ical/.../basic.ics
# Photo capture inbox (point at a synced folder to capture from your phone):
# AGENTBOX_CAPTURE_HOST=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/agentbox-inbox

# AGENTBOX_MAX_TOOL_CALLS=80   # tool-call rounds before a run stops + summarizes (default 50)
# AGENTBOX_DEBUG=1   # verbose debug logging to stderr

# Daily-output journal location on the host (dated markdown, one file per day):
# AGENTBOX_JOURNAL_HOST=./journal
